[Unit]
Description=AI usage & cost dashboard (http://AIdashboard.local)
# A Pi 1 has no real-time clock: TLS fails until NTP has set the time.
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target systemd-time-wait-sync.service

[Service]
Type=simple
User=aidash
Group=aidash
WorkingDirectory=/opt/aidash
Environment=AIDASH_DATA=/var/lib/aidash
Environment=AIDASH_PORT=80
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/aidash/run.py
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=10
# Keep the Pi 1 responsive and the footprint small.
Nice=5
MemoryMax=120M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/aidash

[Install]
WantedBy=multi-user.target
